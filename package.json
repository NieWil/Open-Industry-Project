    "st-oracle": "node scripts/oracle-matiec.mjs",
    "st-oracle:dry": "node scripts/oracle-matiec.mjs --dry-run",
    "st-oracle:ed3": "node scripts/oracle-strucpp.mjs",
    "st-oracle:xml": "node scripts/oracle-plcopen.mjs",
    "st-oracle:import": "node scripts/oracle-import.mjs",
    "st-oracle:openplc": "node scripts/oracle-openplc.mjs",
    "openplc-loop": "node scripts/openplc-loop.mjs",
    "s7-loop": "node scripts/s7-loop.mjs",
    "plant": "node scripts/plant.mjs",
    "bench:behavior": "vitest bench --run --reporter=verbose src/sim/behavior.bench.ts",
    "e2e:server": "node scripts/e2e-server.mjs",
    "lint": "eslint src",
    "check:e2e": "node scripts/check-e2e-hook.mjs",
    "check-submission": "node scripts/check-submission.mjs",
    "library-key": "node scripts/library-key.mjs",
    "library-corpus": "node scripts/library-corpus.mjs",
    "sign-library": "node scripts/sign-library.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@hocuspocus/provider": "^4.3.0",
    "@lezer/highlight": "^1.2.3",
    "fflate": "^0.8.3",
    "jolt-physics": "file:vendor/jolt-physics-1.1.0-oip.8.tgz",
    "monaco-editor": "^0.57.0",
    "occt-import-js": "^0.0.23",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "ses": "2.3.0",
    "three": "^0.186.0",
    "three-mesh-bvh": "^0.9.10",
    "y-codemirror.next": "^0.3.5",
    "y-indexeddb": "^9.0.12",
    "yjs": "^13.6.31"
  },
  "//overrides": [
    "sharp MUST resolve to exactly one copy. @gltf-transform/cli and ndarray-pixels (via",
    "@gltf-transform/functions) declare their own ranges — they have drifted apart before (cli",
    "~0.34.5 vs ndarray-pixels ^0.35.0), and when they do npm installs BOTH, so the CLI process",
    "imports both, loading two native libvips builds into one address space. The symptom is not a",
    "module error: libvips' enum/error state collides and textureCompress dies with",
    "'colourspace: parameter space not set' plus a GLib-CRITICAL about VipsInterpretation value 32.",
    "That fails texture compression silently enough that optimize-assets.mjs then reports the",
    "downstream 'asset budget exceeded' instead. Pin one version so only one copy is installed."
  ],
  "//overrides-dompurify": [
    "monaco-editor 0.56 pinned dompurify to an EXACT 3.4.8, which carries four moderate advisories",
    "(GHSA-c2j3-45gr-mqc4, -cmwh-pvxp-8882, -vxr8-fq34-vvx9, -55q2-fjhq-7xh7 - custom-element and",
    "hook-pollution XSS bypasses). 3.4.16 fixes all four plus GHSA-p98j-92pf-mc4p (3.4.13-3.4.15:",
    "an IN_PLACE afterSanitize hook leaving detached-subtree handlers armed) and is a patch bump",
    "inside the same minor, so force it rather than hold monaco back.",
    "The pin alone does NOT reach the app: monaco 0.57 imports its OWN vendored copy",
    "(esm/vs/base/browser/dompurify/dompurify.js, 3.4.15) by relative path, not this package. What",
    "protects the shipped bundle is scripts/lib/monaco-dompurify.mjs (a vite plugin in vite.config.ts),",
    "which redirects that import to this npm package, so the pinned version is the one that ships.",
    "Drop both when monaco vendors a dompurify at or above 3.4.16 (the plugin then keeps monaco's copy",
    "and warns if this pin is older)."
  ],
  "overrides": {
    "sharp": "0.35.4",
    "dompurify": "3.4.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/cli": "^4.4.0",
    "@gltf-transform/core": "^4.4.0",
    "@gltf-transform/extensions": "^4.4.0",
    "@iwer/devui": "^2.4.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.4.1",
    "ffmpeg-static": "^5.3.0",
    "gltfpack": "^1.1.0",
    "iwer": "^2.2.1",
    "playwright": "^1.60.0",
    "quickjs-emscripten": "^0.32.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.1.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  }
}
