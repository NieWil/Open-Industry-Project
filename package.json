    "build-parts": "node scripts/build-parts.mjs",
    "bake-walls": "node scripts/bake-wall-lighting.mjs",
    "parts:record": "node scripts/record-parts.mjs",
    "bench-embedded-plc": "node scripts/build-embedded-plc.mjs && node scripts/bench-embedded-plc.mjs",
    "check-models": "node scripts/check-orphan-models.mjs",
    "optimize-assets": "node scripts/optimize-assets.mjs",
    "eager-census": "node scripts/eager-census.mjs",
    "eager-check": "node scripts/eager-check.mjs",
    "thumbnails": "node scripts/gen-thumbnails.mjs",
    "validate-project": "node scripts/validate-project.mjs",
    "test-project": "node scripts/test-project.mjs",
    "check-flow": "node scripts/check-flow.mjs",
    "bench-sim": "node scripts/bench-sim.mjs",
    "check-st": "node scripts/check-st.mjs",
    "catalog": "node scripts/catalog.mjs",
    "check-part": "node scripts/check-part.mjs",
    "retired-kinds": "node scripts/retired-kinds.mjs",
    "sdk-usage": "node scripts/sdk-usage.mjs",
    "add-part": "node scripts/add-part.mjs",
    "edit-part": "node scripts/edit-part.mjs",
    "duplicate-parts": "node scripts/duplicate-parts.mjs",
    "inspect-glb": "node scripts/measure-glb.mjs",
    "import-model": "node scripts/import-model.mjs",
    "rename-tag": "node scripts/rename-tag.mjs",
    "assign-io": "node scripts/assign-io.mjs",
    "snap-part": "node scripts/snap-part.mjs",
    "shot-part": "node scripts/shot-part.mjs",
    "capabilities": "node scripts/capabilities.mjs",
    "check-wiring": "node scripts/check-wiring.mjs",
    "check-layout": "node scripts/check-layout.mjs",
    "scaffold-project": "node scripts/scaffold-project.mjs",
    "record-video": "node scripts/record-landing-video.mjs",
    "og-image": "node scripts/gen-og-image.mjs",
