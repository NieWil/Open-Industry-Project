    "desktop-icon": "node scripts/gen-desktop-icon.mjs",
    "desktop:pack": "npm run build && npm --prefix apps/desktop run pack",
    "desktop:release": "node scripts/desktop-release.mjs",
    "desktop:dist": "node scripts/desktop-release-check.mjs && npm run build && npm --prefix apps/desktop run dist",
    "convert-textures": "node scripts/convert-loose-textures.mjs",
    "preview": "vite preview",
    "preview:prod": "node scripts/preview-prod.mjs",
    "preview:slow": "node scripts/preview-prod.mjs --slow",
    "verify-first-load": "node e2e/verify-first-load.mjs",
    "regen-rig-baseline": "node e2e/verify-prod-draco-rigs.mjs --regen",
    "gates": "node scripts/run-gates.mjs",
    "smoke-prod": "node scripts/smoke-prod.mjs",
    "edge-bench": "node scripts/edge-bench.mjs",
    "typecheck": "tsc -b",
    "check": "node scripts/check.mjs",
